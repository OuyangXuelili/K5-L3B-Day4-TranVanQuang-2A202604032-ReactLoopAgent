# Đặt biến trong shell; file này chỉ là mẫu, Python không tự đọc .env.
export PROVIDER=gemini
export MODEL=gemini-3.5-flash-lite
export GEMINI_API_KEY=YOUR_KEY
export MAX_TOKENS=4096
export GEMINI_REASONING_EFFORT=minimal
# export OPENROUTER_API_KEY=YOUR_KEY
# export REASONING_ENABLED=false
# export OPENAI_API_KEY=YOUR_KEY
# export ANTHROPIC_API_KEY=YOUR_KEY
# Chọn PROVIDER/MODEL và key tương ứng nếu dùng provider khác.
# Giữ cùng model/budget/thinking giữa before/after; Gemini 3.x không tắt thinking.
# scripts/evaluate.py --env-file .env đọc KEY=value hoặc export KEY=value;
# run.py và evals/run_evals.py vẫn chỉ đọc biến môi trường shell.
